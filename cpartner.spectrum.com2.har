          "cookies": [],
          "content": {
            "size": 3558,
            "mimeType": "application/json",
            "text": "{\"cq:styleIds\":[\"1603477678354\"],\"styleClasses\":[\"cmp-modal--resi-agent-buyflow\"],\"resourceId\":\"modal-d812c60651\",\"textIsRich\":\"true\",\"sling:resourceType\":\"spectrum/buyflow-business/components/modal\",\":items\":{\"responsivegrid\":{\":items\":{\"text\":{\"styleClasses\":[],\":type\":\"spectrum/buyflow-business/components/text\",\"text\":\"<p><img class=\\\"d-none d-sm-block\\\" src=\\\"/content/dam/spectrum/buyflow-business/background/invincible_wifi_D.png\\\" alt=\\\"\\\"><img class=\\\"d-block d-sm-none\\\" src=\\\"/content/dam/spectrum/buyflow-business/background/invincible_wifi_D.png\\\" alt=\\\"\\\"></p>\\r\\n<p><span class=\\\"cmp-text--font-size-44\\\"><span class=\\\"cmp-text--font-family-Light\\\">Invincible WiFi</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-18\\\">Invincible WiFi is the first and only backup solution that combines WiFi 7 technology with embedded 5G and up to 8 hours of battery backup to keep your business connected through unexpected power outages or network interruptions..</span></p>\\r\\n<ul style=\\\"list-style-type: none; line-height: 25.0px;\\\" class=\\\"no-marker\\\">\\r\\n<li style=\\\"background: url(/content/dam/spectrum/buyflow-business/icons/ki-modem.svg) no-repeat transparent; padding-left: 25.0px; text-align: left;\\\"><span class=\\\"cmp-text--font-size-16\\\">Modem Included</span></li>\\r\\n<li style=\\\"background: url(/content/dam/spectrum/buyflow-business/icons/Router.svg) no-repeat transparent; padding-left: 26.0px; text-align: left;\\\"><span class=\\\"cmp-text--font-size-16\\\">WiFi router delivers ultra-fast speeds, low latency and coverage for hundreds of devices</span></li>\\r\\n<li style=\\\"background: url(/content/dam/spectrum/buyflow-business/icons/ki-battery-empty.svg) no-repeat transparent; padding-left: 26.0px; text-align: left;\\\"><span class=\\\"cmp-text--font-size-16\\\">5G backup with unlimited data</span></li>\\r\\n<li style=\\\"background: url(/content/dam/spectrum/buyflow-business/icons/Router.svg) no-repeat transparent; padding-left: 26.0px; text-align: left;\\\"><span class=\\\"cmp-text--font-size-16\\\">Included battery backup provides up to 8 hours of power</span></li>\\r\\n</ul>\\r\\n<p><span class=\\\"cmp-text--font-size-12\\\">Restrictions apply. Limited to Spectrum WiFi customers with a compatible Spectrum router. Backup service runs on cellular connection during an outage. Cellular signal availability and connectivity can vary by location and cellular network conditions; may not be obtainable in all areas. Fully charged battery backup will provide up to 8 hours of power. Reduced cellular speeds after 100GB/month. Actual speeds will vary and are not guaranteed.</span></p>\\r\\n\",\"id\":\"text-73f62dadea\",\"richText\":true}},\"allowedComponents\":{\"components\":[],\"applicable\":false},\":type\":\"wcm/foundation/components/responsivegrid\",\":itemsOrder\":[\"text\"],\"columnClassNames\":{\"text\":\"aem-GridColumn aem-GridColumn--default--12\"},\"gridClassNames\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"columnCount\":12},\"button_container\":{\":items\":{},\"allowedComponents\":{\"components\":[],\"applicable\":false},\":type\":\"wcm/foundation/components/responsivegrid\",\":itemsOrder\":[],\"columnClassNames\":{},\"gridClassNames\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"columnCount\":12}},\":type\":\"spectrum/buyflow-business/components/modal\",\":itemsOrder\":[\"responsivegrid\",\"button_container\"],\"showOnLoad\":false,\"footerType\":\"default\",\"shouldStopClickEvents\":false,\"shouldHideHeader\":false,\"richtext\":\"<p><span class=\\\"cmp-text--font-family-Regular\\\"><span class=\\\"cmp-text--font-size-16\\\">See Details</span></span></p>\\r\\n\",\"id\":\"\",\"isUseCenteredFlag\":false}"
          },
