            "size": 2244,
            "mimeType": "application/json",
            "text": "{\"cq:styleIds\":[\"1603477678354\"],\"styleClasses\":[\"cmp-modal--resi-agent-buyflow\"],\"resourceId\":\"modal-dc4536e8cc\",\"textIsRich\":\"true\",\"sling:resourceType\":\"spectrum/buyflow-business/components/modal\",\":items\":{\"responsivegrid\":{\":items\":{\"text\":{\"styleClasses\":[\"cmp-text--bluetick\"],\":type\":\"spectrum/buyflow-business/components/text\",\"text\":\"<p><img class=\\\"d-none d-sm-block\\\" src=\\\"/content/dam/spectrum/buyflow-business/icons/promotions/D-Advanced%20Home%20WiFi.png\\\" alt=\\\"\\\"><img class=\\\"d-block d-sm-none\\\" src=\\\"/content/dam/spectrum/buyflow-business/icons/promotions/M-Advanced%20Home%20WiFi.png\\\" alt=\\\"\\\"></p>\\r\\n<p><span class=\\\"cmp-text--font-family-Medium\\\"><span class=\\\"cmp-text--font-size-44\\\">Advanced WiFi</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-family-Light\\\"><span class=\\\"cmp-text--font-size-18\\\">Power hundreds of devices with the most advanced WiFi technology. Advanced WiFi includes state-of-the-art security and privacy features to protect all of the customer’s connected devices.</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-family-Medium\\\"><span class=\\\"cmp-text--font-size-28\\\">Benefits</span></span></p>\\r\\n<ul>\\r\\n<li><span class=\\\"cmp-text--font-family-Light\\\"><span class=\\\"cmp-text--font-size-18\\\">Connected devices are automatically protected</span></span></li>\\r\\n<li><span class=\\\"cmp-text--font-family-Light\\\"><span class=\\\"cmp-text--font-size-18\\\">Control which devices can connect, and when</span></span></li>\\r\\n<li><span class=\\\"cmp-text--font-family-Light\\\"><span class=\\\"cmp-text--font-size-18\\\">Easily manage the WiFi network through the My Spectrum App</span></span></li>\\r\\n</ul>\\r\\n\",\"id\":\"text-5badf6b048\",\"richText\":true}},\"allowedComponents\":{\"components\":[],\"applicable\":false},\":type\":\"wcm/foundation/components/responsivegrid\",\":itemsOrder\":[\"text\"],\"columnClassNames\":{\"text\":\"aem-GridColumn aem-GridColumn--default--12\"},\"gridClassNames\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"columnCount\":12}},\":type\":\"spectrum/buyflow-business/components/modal\",\":itemsOrder\":[\"responsivegrid\"],\"showOnLoad\":false,\"footerType\":\"default\",\"shouldStopClickEvents\":false,\"shouldHideHeader\":false,\"richtext\":\"<p><u>See details</u>.</p>\\r\\n\",\"id\":\"\",\"isUseCenteredFlag\":false}"
