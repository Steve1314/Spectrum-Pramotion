            "text": "{\"emptyFieldErrorMsg\":\"This is a required field.\",\"existingLineHeadline\":\"Existing line details\",\"lineEntryLabel\":\"Phone Line\",\"freeLineEntryLabel\":\"First phone line is free for $replacer months with promotional offer.\",\"resourceId\":\"phoneLine-f991e40161\",\"portabilityErrorMsg\":\"This phone number $ can't be ported. Please confirm the information and try again.\",\"redIndicatorMsg\":\"Advise customer that a Local Freeze exists on the account. The order can be completed in Gateway. The customer should contact their current provider to resolve the issue before the port can be completed.\",\"removeLineLabel\":\"Remove\",\"portabilityMsg\":\"Your $ phone number can be ported\",\"sling:resourceType\":\"spectrum/buyflow-business/components/form/phoneLine\",\"yellowIndicatorMsg\":\"Customer's account with Donor LEC currently indicates a service address different than the address entered for this order. Please confirm the address with the customer and make the appropriate corrections.\",\"duplicatePhoneErrorMsg\":\"This number is already added for portability.\",\":items\":{\"existingBillingAddress\":{\":items\":{\"zip\":{\"styleClasses\":[],\"constraintMessage\":\"\",\"childLabel\":\"\",\"rules\":[{\"maxChar\":2,\"rule\":\"numeric\",\"minChar\":2,\"overrideRule\":\"\",\"message\":\"\"},{\"maxChar\":2,\"rule\":\"zipcode\",\"minChar\":2,\"overrideRule\":\"\",\"message\":\"\"}],\"readOnly\":false,\"rows\":2,\"title\":\"ZIP code\",\"type\":\"text\",\"usePlaceholder\":true,\"required\":false,\"helpMessage\":\"ZIP code\",\":type\":\"spectrum/buyflow-business/components/form/text\",\"hideTitle\":false,\"childPlaceholder\":\"placeholder\",\"hasChild\":false,\"childName\":\"\",\"name\":\"zipcode\",\"childMessage\":\"\",\"noResultsMessage\":\"\",\"placeholder\":\"ZIP code\",\"id\":\"form-text-438393117\",\"value\":\"\",\"requiredMessage\":\"\"},\"city\":{\"styleClasses\":[],\"constraintMessage\":\"\",\"childLabel\":\"\",\"readOnly\":false,\"