            "size": 1867,
            "mimeType": "application/json",
            "text": "{\":items\":{\"responsivegrid\":{\":items\":{\"xref\":{\":items\":{},\"resourceId\":\"xref-7c73ab20dd\",\":type\":\"spectrum/buyflow-business/components/content/xref\",\":itemsOrder\":[],\"sling:resourceType\":\"spectrum/buyflow-business/components/content/xref\",\"id\":\"\"},\"text\":{\"styleClasses\":[],\":type\":\"spectrum/buyflow-business/components/text\",\"text\":\"<p><span class=\\\"cmp-text--font-family-Bold\\\"><span class=\\\"cmp-text--font-size-24\\\">Remote Number Forwarding</span></span><br>\\r\\n</p>\\r\\n<p>Add inbound-only numbers that are from outside the customer's calling area. This give's the business a local presence with a city-specific area code routing to any number.</p>\\r\\n<p>&nbsp;</p>\\r\\n<p><span class=\\\"cmp-text--font-family-Bold\\\"><span class=\\\"cmp-text--font-size-24\\\">Toll-Free Number</span></span></p>\\r\\n<p>A toll-free number makes it easy for customers and colleagues to reach the business.<br>\\r\\n</p>\\r\\n\",\"id\":\"text-d3e64a95e7\",\"richText\":true}},\"allowedComponents\":{\"components\":[],\"applicable\":false},\":type\":\"wcm/foundation/components/responsivegrid\",\":itemsOrder\":[\"xref\",\"text\"],\"columnClassNames\":{\"xref\":\"aem-GridColumn aem-GridColumn--default--12\",\"text\":\"aem-GridColumn aem-GridColumn--default--12\"},\"gridClassNames\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"columnCount\":12}},\"cq:styleIds\":[\"1597793620310\"],\"styleClasses\":[\"cmp-modal--compare-products\"],\"resourceId\":\"modal-fde42df20c\",\":type\":\"spectrum/buyflow-business/components/modal\",\":itemsOrder\":[\"responsivegrid\"],\"textIsRich\":\"true\",\"sling:resourceType\":\"spectrum/buyflow-business/components/modal\",\"richtext\":\"<p><span class=\\\"cmp-text--font-family-Light\\\">Business plans include one phone line. Up to eight lines can be added. To transfer an existing phone number, select “Existing Number.” View <u>phone line details.</u></span><br>\\r\\n</p>\\r\\n\",\"id\":\"\",\"headerTitle\":\"Phone line details\"}"
          },
