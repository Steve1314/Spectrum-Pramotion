          "content": {
            "size": 3557,
            "mimeType": "application/json",
            "text": "{\"cq:styleIds\":[\"1603477678354\"],\"styleClasses\":[\"cmp-modal--resi-agent-buyflow\"],\"resourceId\":\"modal-4e7350102d\",\"textIsRich\":\"true\",\"sling:resourceType\":\"spectrum/buyflow-business/components/modal\",\":items\":{\"responsivegrid\":{\":items\":{\"text\":{\"styleClasses\":[],\":type\":\"spectrum/buyflow-business/components/text\",\"text\":\"<p><span class=\\\"cmp-text--font-size-24\\\"><span class=\\\"cmp-text--font-family-SemiBold\\\"><b>What is a modem?</b><br>\\r\\n</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-family-Light\\\"><span class=\\\"cmp-text--font-size-18\\\">A modem is a device that brings Internet service into your home.</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-24\\\"><span class=\\\"cmp-text--font-family-SemiBold\\\">&nbsp;</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-24\\\"><span class=\\\"cmp-text--font-family-SemiBold\\\"><b>What is a WiFi router?</b><br>\\r\\n</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-family-Light\\\"><span class=\\\"cmp-text--font-size-18\\\">A wireless router provides wire-free Internet access to your devices.</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-24\\\"><span class=\\\"cmp-text--font-family-SemiBold\\\">&nbsp;</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-24\\\"><span class=\\\"cmp-text--font-family-SemiBold\\\"><b>Why should I choose Spectrum equipment?</b><br>\\r\\n</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-18\\\"><span class=\\\"cmp-text--font-family-Light\\\">Spectrum equipment is fully compliant, certified and pre-configured for optimal</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-18\\\"><span class=\\\"cmp-text--font-family-Light\\\">performance. Spectrum technicians will only install equipment provided by</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-18\\\"><span class=\\\"cmp-text--font-family-Light\\\">Spectrum. Spectrum WiFi routers also include additional security, parental controls</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-18\\\"><span class=\\\"cmp-text--font-family-Light\\\">and other features.</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-24\\\"><span class=\\\"cmp-text--font-family-SemiBold\\\">&nbsp;</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-24\\\"><span class=\\\"cmp-text--font-family-SemiBold\\\"><b>Can I use my own equipment?</b><br>\\r\\n</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-18\\\"><span class=\\\"cmp-text--font-family-Light\\\">You have the option to supply your own equipment but compatibility, speeds and</span></span></p>\\r\\n<p><span class=\\\"cmp-text--font-size-18\\\"><span class=\\\"cmp-text--font-family-Light\\\">security are not guaranteed.</span></span></p>\\r\\n\",\"id\":\"text-98eda1bd5e\",\"richText\":true}},\"allowedComponents\":{\"components\":[],\"applicable\":false},\":type\":\"wcm/foundation/components/responsivegrid\",\":itemsOrder\":[\"text\"],\"columnClassNames\":{\"text\":\"aem-GridColumn aem-GridColumn--default--12\"},\"gridClassNames\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"columnCount\":12},\"button_container\":{\":items\":{},\"allowedComponents\":{\"components\":[],\"applicable\":false},\":type\":\"wcm/foundation/components/responsivegrid\",\":itemsOrder\":[],\"columnClassNames\":{},\"gridClassNames\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"columnCount\":12}},\":type\":\"spectrum/buyflow-business/components/modal\",\":itemsOrder\":[\"responsivegrid\",\"button_container\"],\"showOnLoad\":false,\"footerType\":\"default\",\"shouldStopClickEvents\":false,\"shouldHideHeader\":false,\"richtext\":\"<p><u>Learn more.</u></p>\\r\\n\",\"id\":\"\",\"isUseCenteredFlag\":false,\"headerTitle\":\"Which equipment is right for me?\"}"
